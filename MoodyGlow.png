<svg xmlns="http://www.w3.org/2000/svg" width="180" height="180" viewBox="0 0 180 180">
  <defs>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1a1a24"/>
      <stop offset="100%" stop-color="#050508"/>
    </linearGradient>
  </defs>

  <!-- Background: dark rounded square -->
  <rect width="180" height="180" rx="42" ry="42" fill="url(#bgGrad)"/>

  <!-- Inner dark area -->
  <rect x="18" y="18" width="144" height="144" rx="32" ry="32" fill="#0a0a12"/>

  <!-- Glowing yellow outline (simulates the Outline animation) -->
  <rect x="34" y="34" width="112" height="112" rx="22" ry="22"
        fill="none" stroke="#D9F21A" stroke-width="5"
        filter="url(#glow)" opacity="0.95"/>

  <!-- Center glowing dot -->
  <circle cx="90" cy="90" r="10" fill="#D9F21A" filter="url(#glow)"/>

  <!-- Subtle notch representation at top -->
  <rect x="72" y="18" width="36" height="6" rx="3" fill="#0a0a12"/>
</svg>
